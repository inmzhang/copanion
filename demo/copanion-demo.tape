Output demo/copanion-demo.gif

Set Shell "zsh"
Set Theme "GruvboxDark"
Set FontSize 26
Set Width 1500
Set Height 960
Set Padding 24
Set WindowBar Rings
Set TypingSpeed 20ms
Set PlaybackSpeed 1.1

Sleep 1s
Type "copanion" Enter
Sleep 1s

Type "f"
Sleep 300ms
Type "app"
Sleep 300ms
Enter
Sleep 1s

Type "n"
Sleep 500ms
Type "This file defines the main copanion app state and navigation helpers."
Sleep 300ms
Ctrl+S
Sleep 1s

Down 17
Sleep 300ms
Type "v"
Sleep 300ms
Down 4
Sleep 300ms
Type "a"
Sleep 500ms
Type "What is this enum used for?"
Sleep 300ms
Ctrl+S
Sleep 1s

Type "g"
Sleep 300ms
Type "]"
Sleep 600ms
Type "]"
Sleep 900ms

Type "x"
Sleep 2s

Type 'codex' Enter
Sleep 2s
Paste
Sleep 300ms
Enter
Sleep 2s
